FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=True
ENV APP_HOME=/app

WORKDIR ${APP_HOME}

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip3 install --upgrade pip

RUN pip3 install \
    torch \
    torchvision \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu128

RUN pip3 install --no-cache-dir -r requirements.txt

COPY . .

RUN python3 -c "import torch; print('Torch:',torch.__version__); print('CUDA:',torch.version.cuda)"

RUN torch-model-archiver \
    --model-name yolov7 \
    --version 1.0 \
    --handler model_handler.py \
    --extra-files "yolov7/models/experimental.py,yolov7/models/common.py,yolov7/models/yolo.py,yolov7/utils/general.py,yolov7/utils/torch_utils.py,yolov7/utils/plots.py,yolov7/utils/datasets.py"

RUN mkdir model_store && mv yolov7.mar model_store/

EXPOSE 8080 8081 8082

CMD ["torchserve", "--start", "--ncs", "--ts-config", "/app/config.properties", "--model-store", "model_store", "--models", "yolov7.mar"]
