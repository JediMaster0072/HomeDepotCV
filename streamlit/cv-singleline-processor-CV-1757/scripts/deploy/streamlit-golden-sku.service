[Unit]
Description=Home Depot Golden SKU Streamlit review app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avinash.patel
Group=avinash.patel
WorkingDirectory=/home/avinash.patel/HomeDepotCV/cv-singleline-processor-CV-1757
Environment=HOME=/home/avinash.patel
Environment=PYTHONUNBUFFERED=1
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/home/avinash.patel/HomeDepotCV/.venv/bin/streamlit run scripts/golden_dataset/streamlit_expected_sku_review.py --server.address 0.0.0.0 --server.port 8501 --server.enableCORS false --server.enableXsrfProtection true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
